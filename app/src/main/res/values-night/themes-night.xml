<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AppEncuestas" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary_dark_mode</item>
        <item name="colorPrimaryVariant">@color/primary_container_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/accent_dark_mode</item>
        <item name="colorSecondaryVariant">@color/accent_container_dark</item>
        <item name="colorOnSecondary">@color/on_secondary_container_dark</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_container_dark</item>
        <item name="android:navigationBarColor">@color/accent_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Surface colors -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:windowBackground">@drawable/fondo1</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>

        <!-- Error colors -->
        <item name="colorError">@color/error_dark</item>
        <item name="colorOnError">@color/white</item>

        <!-- Text colors -->
        <item name="android:textColor">@color/on_surface_dark</item>
        <item name="android:textColorSecondary">@color/on_surface_variant_dark</item>
    </style>
</resources>