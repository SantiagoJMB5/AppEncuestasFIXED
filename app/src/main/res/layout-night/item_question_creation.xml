<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/mandatory_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/question_mandatory"
                android:textColor="@color/text_primary_dark" />

            <ImageButton
                android:id="@+id/close_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_question"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_primary_dark" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/question_text_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/question_text_hint"
            app:boxStrokeColor="@color/primary_color_light"
            app:hintTextColor="@color/primary_color_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/question_text_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="@color/text_primary_dark" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <!-- Options will be added here dynamically -->

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_option_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_option"
            android:textColor="@color/primary_color_light"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView> 